# Copy to .env and fill in. Never commit .env.

# --- LLM provider -----------------------------------------------------------
# Default: Google Gemini FREE tier. Get a free key (no credit card) at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini             # gemini | groq | openrouter | ollama | openai | anthropic
GEMINI_API_KEY=
# LLM_MODEL=                    # empty = provider default (gemini: gemini-3.5-flash-lite).
                                # Free quotas are per model; e.g. gemini-3.8-flash allows only 20 requests/day
LLM_EFFORT=medium               # low | medium | high  (reasoning effort, where supported)

# Free tiers are rate limited. The worker spaces its requests automatically.
# Leave 0 to use the provider preset; the limiter also adopts the limit a 429 response reports.
LLM_RPM=0                       # requests per minute
LLM_TPM=0                       # tokens per minute

# Other providers (set LLM_PROVIDER accordingly):
# GROQ_API_KEY=                 # free at https://console.groq.com/keys  (small tokens/min limit)
# OPENROUTER_API_KEY=           # free ":free" models at https://openrouter.ai  (set LLM_MODEL)
# (ollama needs no key: install Ollama, `ollama pull qwen3:14b`)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=            # paid; LLM_PROVIDER=anthropic uses claude-opus-5-5 by default
# LLM_BASE_URL=                 # override the API base URL (any OpenAI-compatible server)

# --- Budgets -----------------------------------------------------------------
MAX_STEPS=60
MAX_MINUTES=30                  # free-tier rate limits make runs slower
MAX_COST_USD=5                  # only meaningful for paid providers
MAX_VERIFY_ROUNDS=2
HUMAN_TIMEOUT_S=900

# --- Browser -------------------------------------------------------------------
HEADLESS=true                   # false = watch the browser (also: --headed)
RECORD_VIDEO=true
