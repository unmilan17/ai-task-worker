# Copy to .env and fill in. Never commit .env.

# --- LLM -----------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-opus-5-5       # e.g. claude-sonnet-5-5 for cheaper runs
LLM_EFFORT=medium               # low | medium | high | xhigh | max
ANTHROPIC_REFUSAL_FALLBACK=true # server-side fallback model if a request is declined
# OPENAI_API_KEY=               # only if LLM_PROVIDER=openai

# --- Budgets ---------------------------------------------------------------
MAX_STEPS=60
MAX_MINUTES=20
MAX_COST_USD=5
MAX_VERIFY_ROUNDS=2
HUMAN_TIMEOUT_S=900

# --- Browser ----------------------------------------------------------------
HEADLESS=true                   # false = watch the browser (also: --headed)
RECORD_VIDEO=true
